<Window x:Class="DisplaySwitcher.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DisplaySwitcher.Gui.Controls"
        Title="Sunshine Display Switcher"
        Height="820" Width="1080"
        MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackground}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Sunshine Display Switcher" Style="{StaticResource Heading}" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="Choose which displays are on while you stream, and which come back when the stream ends. Every switch is verified against the live topology before it is reported as successful." />
        </StackPanel>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0,12,0,0">

            <!-- ============================ PROFILES ============================ -->
            <TabItem Header="Display profiles">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="200" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Profile selector -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Editing profile" VerticalAlignment="Center"
                                       Margin="0,0,10,0" FontWeight="SemiBold" />

                            <ComboBox Grid.Column="1" x:Name="ProfileSelector" MinWidth="270"
                                      ItemsSource="{Binding Profiles}"
                                      SelectionChanged="OnProfileChanged" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button Content="Import current layout" Click="OnImportLive" Margin="0,0,8,0"
                                        ToolTip="Replace this profile with the arrangement that is on screen right now" />
                                <Button Content="Preview" Click="OnPreview" Margin="0,0,8,0"
                                        ToolTip="Apply this profile now so you can see it" />
                                <Button Content="Save profile" Click="OnSave" Style="{StaticResource AccentButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Arrangement canvas -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                        <controls:ArrangementCanvas x:Name="Arrangement" />
                    </Border>

                    <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="2,6,0,0"
                               Text="Drag a display to rearrange it. Edges snap to neighbours, because Windows will not accept a layout with a gap between displays." />

                    <!-- Inactive tray -->
                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,12" Margin="0,10,0,0"
                            Visibility="{Binding HasInactive, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Not used in this profile" Style="{StaticResource SubHeading}" />
                            <ItemsControl ItemsSource="{Binding InactiveMonitors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,8,0" Padding="12,7" Click="OnTrayMonitorClicked"
                                                Tag="{Binding}" MinWidth="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding Label}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Selected monitor editor -->
                    <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="SelectedTitle" Style="{StaticResource SubHeading}" Text="No display selected" />
                            <TextBlock x:Name="SelectedDetail" Style="{StaticResource Caption}" Margin="0,0,0,10" />

                            <Grid x:Name="SelectedEditor" IsEnabled="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0" Grid.Column="0" x:Name="UseDisplayCheck"
                                          Content="Use this display" Margin="0,0,24,8" Click="OnUseDisplayToggled" />

                                <CheckBox Grid.Row="0" Grid.Column="1" x:Name="PrimaryCheck"
                                          Content="Make this my main display" Margin="0,0,0,8" Click="OnPrimaryToggled" />

                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,24,0">
                                    <TextBlock Text="Resolution" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ComboBox x:Name="ResolutionCombo" MinWidth="150"
                                              DisplayMemberPath="Label"
                                              SelectionChanged="OnResolutionChanged" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="Refresh rate" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ComboBox x:Name="RefreshCombo" MinWidth="120"
                                              SelectionChanged="OnRefreshChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat={}{0} Hz}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="StatusBar" CornerRadius="5" Padding="12,9" Margin="0,14,0,0"
                                    Background="#FFF2F6FB" BorderBrush="#FFD6E4F0" BorderThickness="1">
                                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Ready." />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================ SUNSHINE ============================ -->
            <TabItem Header="Sunshine">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Sunshine configuration" Style="{StaticResource SubHeading}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                           Text="DisplaySwitcher runs as a Sunshine global prep command: 'activate' when a Moonlight client connects, 'restore' when it disconnects. Editing sunshine.conf needs administrator rights, so these buttons will prompt for elevation." />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Config file" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox Grid.Column="1" x:Name="SunshineConfigPath" IsReadOnly="True" />
                                    <Button Grid.Column="2" Content="Browse" Click="OnBrowseSunshine" Margin="8,0,0,0" />
                                </Grid>

                                <TextBlock x:Name="SunshineStatus" Style="{StaticResource Caption}" Margin="0,0,0,12" />

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="InstallHookButton" Content="Wire into Sunshine"
                                            Style="{StaticResource AccentButton}" Click="OnInstallHook" Margin="0,0,8,0" />
                                    <Button Content="Remove from Sunshine" Click="OnRemoveHook" Margin="0,0,8,0" MinWidth="160" />
                                    <Button Content="Restart Sunshine" Click="OnRestartSunshine" Margin="0,0,8,0" MinWidth="130" />
                                    <Button Content="Refresh" Click="OnRefreshSunshine" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Prep commands currently configured" Style="{StaticResource SubHeading}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                           Text="Entries that belong to other tools are always left untouched." />
                                <ItemsControl x:Name="PrepCommandList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1"
                                                    Padding="0,8">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Owner}" />
                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding DoLine}" />
                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding UndoLine}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoPrepCommands" Style="{StaticResource Caption}"
                                           Text="No global prep commands are configured." Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ DISPLAYS ============================ -->
            <TabItem Header="Detected displays">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Refresh" Click="OnRefreshDisplays" Margin="0,0,8,0" />
                        <Button Content="Copy for bug report" Click="OnCopyDiagnostics" MinWidth="150" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <TextBox x:Name="DiagnosticsText" IsReadOnly="True" BorderThickness="0"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Padding="14" TextWrapping="NoWrap" Background="Transparent" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================ SETTINGS ============================ -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Verification and retries" Style="{StaticResource SubHeading}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                                           Text="After every switch the live topology is re-read and compared against what was requested. A successful return code from Windows is not treated as proof that a monitor actually lit up." />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Wait before verifying" VerticalAlignment="Center" Margin="0,5" />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="VerifyDelayBox" Margin="0,3" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" Text="seconds" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Attempts before giving up" VerticalAlignment="Center" Margin="0,5" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="MaxRetriesBox" Margin="0,3" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Wait between attempts" VerticalAlignment="Center" Margin="0,5" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="RetryDelayBox" Margin="0,3" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" Text="seconds" />

                                    <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" x:Name="DdcCiCheck"
                                              Content="Power-cycle a stubborn monitor over DDC/CI as a last resort" Margin="0,10,0,4" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Caption}" Margin="24,0,0,8"
                                               Text="Some monitors need a real firmware power cycle to re-negotiate their EDID. This is only attempted after every normal retry has failed." />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Keep logs for" VerticalAlignment="Center" Margin="0,5" />
                                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="LogRetentionBox" Margin="0,3" />
                                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" Text="days" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Save settings" Style="{StaticResource AccentButton}" Click="OnSaveSettings" Margin="0,0,8,0" />
                                    <Button Content="Open data folder" Click="OnOpenDataFolder" MinWidth="140" />
                                </StackPanel>
                                <TextBlock x:Name="SettingsStatus" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Recent log" Style="{StaticResource SubHeading}" />
                                    <Button Content="Reload" Click="OnReloadLog" HorizontalAlignment="Right" MinWidth="80" Padding="12,4" />
                                </Grid>
                                <Border Background="#FF1E1E1E" CornerRadius="6" Padding="0">
                                    <TextBox x:Name="LogText" IsReadOnly="True" BorderThickness="0" Height="260"
                                             Background="Transparent" Foreground="#FFDCDCDC"
                                             FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             Padding="12" TextWrapping="NoWrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
