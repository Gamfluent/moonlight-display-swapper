<Window x:Class="DisplaySwitcher.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sunshine Display Switcher &#x2013; Setup"
        Height="740" Width="820"
        MinHeight="600" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackground}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Connect DisplaySwitcher to Sunshine" Style="{StaticResource Heading}" />
            <TextBlock Style="{StaticResource Caption}"
                       Text="This adds a pair of prep commands to Sunshine so your displays switch automatically: 'activate' when a Moonlight client connects, 'restore' when it disconnects. Nothing is installed or copied &#x2013; the app stays in this folder." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Step 1: the app itself -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="1.  DisplaySwitcher" Style="{StaticResource SubHeading}" />
                        <TextBlock x:Name="ExeStatus" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="ProfileStatus" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        <Button x:Name="OpenAppButton" Content="Open DisplaySwitcher to set up profiles"
                                Click="OnOpenApp" HorizontalAlignment="Left" Margin="0,10,0,0" MinWidth="260" />
                    </StackPanel>
                </Border>

                <!-- Step 2: sunshine.conf -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="2.  Sunshine configuration file" Style="{StaticResource SubHeading}" />
                        <TextBlock x:Name="DetectionStatus" Style="{StaticResource Caption}" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="ConfigPathBox" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="Browse" Click="OnBrowse" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Step 3: prep commands -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="3.  Prep commands in this config" Style="{StaticResource SubHeading}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                   Text="Commands belonging to other tools are never modified or reordered. A timestamped backup of sunshine.conf is written before any change." />

                        <ItemsControl x:Name="PrepList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="0,9">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Owner}" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding DoLine}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding UndoLine}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="EmptyPrepNote" Style="{StaticResource Caption}"
                                   Text="No global prep commands are configured yet." Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Step 4: actions -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="4.  Apply" Style="{StaticResource SubHeading}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button x:Name="InstallButton" Content="Wire into Sunshine"
                                    Style="{StaticResource AccentButton}" Click="OnInstall" Margin="0,0,8,0" MinWidth="170" />
                            <Button x:Name="RemoveButton" Content="Remove from Sunshine"
                                    Click="OnRemove" Margin="0,0,8,0" MinWidth="170" />
                            <Button x:Name="RestartButton" Content="Restart Sunshine"
                                    Click="OnRestart" MinWidth="140" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   Text="Sunshine only reads its configuration when it starts, so restart it after making a change." />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" x:Name="ResultBar" CornerRadius="5" Padding="12,10" Margin="0,14,0,0"
                Background="#FFF2F6FB" BorderBrush="#FFD6E4F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="ResultText" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Ready." />
                <Button Grid.Column="1" Content="Close" Click="OnClose" Margin="12,0,0,0" MinWidth="80" />
            </Grid>
        </Border>
    </Grid>
</Window>
