<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <AssemblyName>Setup</AssemblyName>
    <RootNamespace>DisplaySwitcher.Setup</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- See the note in DisplaySwitcher.csproj: WPF binding requires a non-invariant culture. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Sunshine Display Switcher Setup</Product>
    <Company>Gamfluent</Company>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DisplaySwitcher.Core\DisplaySwitcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="..\Shared\Theme.xaml" Link="Theme.xaml" />
  </ItemGroup>

</Project>
